pragma solidity 0.8.17;

import "./SpecialEnd.sol";

// Pre-formated Metadata of the 1/1s
library Special {
    string internal constant ELEMENT_0 =
        "data:application/json;base64,";
    string internal constant ELEMENT_1 =
        "data:application/json;base64,";
    string internal constant ELEMENT_2 =
        "data:application/json;base64,";

    function traits(uint256 i) external pure returns (string memory) {
        require(i <= 5, "not a valid 1/1");
        if (i == 0) return ELEMENT_0;
        if (i == 1) return ELEMENT_1;
        if (i == 2) return ELEMENT_2;
        return SpecialEnd.traits(i);
    }
}
